# Scratch output from the scripts in tools/. The rendered HTML in docs/ is NOT
# ignored: it is the form of the document people read, so it is committed alongside
# the Markdown it comes from.

# Scratch output directory, at any depth. github_preview.py writes beside its source
# by default, so anything landing here was sent there deliberately and is throwaway.
out/

# Python virtual environments created by setup.sh, setup.ps1 and github_preview.bat.
.venv/
venv/

# Python bytecode.
__pycache__/
*.py[cod]
