# Scratch output from the scripts in tools/. The one generated file that IS tracked
# is github-ssh-setup.github.html in the repository root: it is the form of the
# document people read, so it is committed alongside the Markdown it comes from.

# Default output directory for github_preview.py, at any depth. Previews written
# here are throwaway, unlike the tracked copy in the repository root.
out/

# Python virtual environments created by setup.sh, setup.ps1 and preview-github.bat.
.venv/
venv/

# Python bytecode.
__pycache__/
*.py[cod]
