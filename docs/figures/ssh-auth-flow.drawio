        <mxCell id="edge-11" value="verifies against" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="sshd" target="acct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-12" value="git protocol" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="sshd" target="repo">
