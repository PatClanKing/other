        <mxCell id="edge-10" value="signed challenge" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="ssh" target="sshd">
