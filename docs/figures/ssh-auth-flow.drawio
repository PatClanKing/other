          <mxGeometry x="1612" y="903" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t-key" value="The private key never travels. ssh proves you hold it by having the agent sign a challenge with it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#102027;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1031" width="803" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="t-pair" value="Blue = you run it.   Green = a running process.   Yellow = a file SSH reads.   Purple = your key pair.   Orange = a shell startup file.   Pink = GitHub.   A page glyph marks every box that is a file on disk." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#102027;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1059" width="1440" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="edge-0" value="runs" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="git" target="ssh">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-1" value="reads" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="ssh" target="config">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-2" value="asks to sign" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="ssh" target="agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-3" value="reads" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="priv" target="sshadd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-4" value="adds key" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="sshadd" target="agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-5" value="starts one per login" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="bashrc" target="agent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-6" value="then runs this to load the keys" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="bashrc" target="sshadd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-7" value="checks host key" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="ssh" target="known">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-8" value="must match" style="endArrow=open;endSize=12;html=1;rounded=0;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="hostkey" target="known">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-9" value="uploaded once" style="endArrow=blockThin;endFill=1;endSize=8;html=1;rounded=1;edgeStyle=none;strokeColor=#37474F;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="pub" target="acct">
